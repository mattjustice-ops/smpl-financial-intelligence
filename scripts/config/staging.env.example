# Copy to frontend/.env.staging.local (gitignored) after creating staging infra.
# Do not commit real credentials.

# Railway staging FastAPI public URL (no trailing slash)
STAGING_API_URL=https://sfi-api-staging-YOUR-SERVICE.up.railway.app

# Neon staging branch connection string (same schema as prod; separate data)
STAGING_DATABASE_URL=postgresql://USER:PASSWORD@ep-STAGING.neon.tech/neondb?sslmode=require

# Optional — Vercel Preview deployment URL for browser smoke (update per branch deploy)
STAGING_FRONTEND_URL=https://smpl-financial-intelligence-git-main-smplai.vercel.app

# Demo org on staging DB (seed or copy from prod). Default matches SMPL Demo Co.
STAGING_ORGANIZATION_ID=8571e520-0687-4516-bdee-379f37c58c1f
