{
  "name": "sfi-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:kill": "powershell -ExecutionPolicy Bypass -File ./scripts/kill-port.ps1 -Port 3002",
    "dev:fresh": "powershell -ExecutionPolicy Bypass -File ./scripts/restart-dev.ps1 -Port 3002",
    "dev:restart": "powershell -ExecutionPolicy Bypass -File ./scripts/restart-dev.ps1 -Port 3002",
    "reset:platform": "node scripts/reset-platform.mjs",
    "snapshot:platform": "node scripts/reset-platform.mjs --snapshot",
    "copy:board-exports": "node scripts/copy-board-exports.mjs",
    "extract:demo-seed": "node scripts/extract-demo-seed.mjs",
    "verify:outlook": "node scripts/verify-outlook-alignment.mjs",
    "verify:board": "node scripts/verify-board-platform.mjs",
    "verify:forecast": "node scripts/verify-forecast-levers.mjs",
    "verify:platform": "npm run verify:board && npm run verify:outlook && npm run verify:pipeline-arr",
    "verify:pipeline-arr": "node scripts/verify-pipeline-arr.mjs",
    "validate:csv-pack": "node scripts/validate-csv-pack.mjs",
    "verify:sales-talk": "node --experimental-strip-types scripts/verify-sales-talk-retrieve.mjs",
    "generate:brand-icons": "node scripts/generate-brand-icons.mjs",
    "prebuild": "node scripts/copy-board-exports.mjs && node scripts/extract-demo-seed.mjs && node scripts/verify-board-platform.mjs && node scripts/verify-outlook-alignment.mjs",
    "dev:3000": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed:sanity": "node scripts/seed-sanity.mjs",
    "publish:finance-os-posts": "node scripts/publish-finance-os-posts.mjs"
  },
  "dependencies": {
    "@portabletext/react": "^3.2.4",
    "@sanity/client": "^6.29.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^3.99.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.469.0",
    "next": "14.2.18",
    "next-auth": "^5.0.0-beta.25",
    "next-sanity": "^9.12.3",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanity": "^3.99.0",
    "server-only": "^0.0.1",
    "stripe": "^17.7.0",
    "styled-components": "^6.4.4",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  }
}
